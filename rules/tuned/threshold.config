# Ladenie FP - PROFIL "PO LADENI" (kap. 5.3)
# Kazda polozka je zdovodnena datami z behu "pred ladenim" (signatures.csv,
# riadky role=benign). Postup: po behu `before` pozri v
# results/runs/before_*/signatures.csv signatury s role=benign a pre kazdu
# rozhodni: potlacit (informacna, bez bezpecnostnej hodnoty v tejto sieti)
# alebo ponechat (FP, ktory treba v praci priznat).

# GPL ICMP PING *NIX - bezny ping, informacna signatura (30 FP v behu 2026-09-23)
suppress gen_id 1, sig_id 2100366

# SURICATA HTTP Response excessive header repetition - vlastnost odpovedi
# DVWA (opakovane Set-Cookie/Pragma hlavicky), nie utok. Potlacena IBA pre
# odpovede zo servera DVWA (30 FP v behu 2026-09-23).
suppress gen_id 1, sig_id 2221036, track by_src, ip 172.28.0.11

# ET INFO POSSIBLE Web Crawl using Curl - informacna, curl je legitimny nastroj
suppress gen_id 1, sig_id 2002825
